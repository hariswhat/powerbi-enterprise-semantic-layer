/// GL actuals at account x cost center x entity x period x posting date (fin.vw_fact_gl_summary). Partitioned by posting date (ADR-0004).
table 'GL Actual'
	lineageTag: b3fbc0dd-9da0-5935-bcc9-f6756bd163dc

	column period_date_key
		dataType: int64
		isHidden
		lineageTag: 38df3d76-ae11-572f-bd9c-709235509280
		summarizeBy: none
		sourceColumn: period_date_key

	column account_key
		dataType: int64
		isHidden
		lineageTag: 3c72f51f-ce22-56ba-80e2-79d091604521
		summarizeBy: none
		sourceColumn: account_key

	column cost_center_key
		dataType: int64
		isHidden
		lineageTag: 94e21118-f6f5-5fe2-ae06-db5a582fbf91
		summarizeBy: none
		sourceColumn: cost_center_key

	column entity_key
		dataType: int64
		isHidden
		lineageTag: db617e7d-f87e-5221-9510-fcd0daa658ce
		summarizeBy: none
		sourceColumn: entity_key

	column is_reversal
		dataType: int64
		isHidden
		lineageTag: 58bc3889-92ff-5b98-ba5f-3c3a026094db
		summarizeBy: none
		sourceColumn: is_reversal

	column amount_usd
		dataType: decimal
		isHidden
		formatString: #,0
