		summarizeBy: sum
		sourceColumn: amount_usd

	column amount_usd_budget_rate
		dataType: decimal
		isHidden
		formatString: #,0
		lineageTag: 4d1ae37f-8112-5e4d-9596-183a73bf7552
		summarizeBy: sum
		sourceColumn: amount_usd_budget_rate

	/// Drives incremental refresh only. Reporting uses the fiscal period.
	column posting_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 978a22a0-535d-595c-a398-f8ff12ba5e5c
		summarizeBy: none
		sourceColumn: posting_date

	partition 'GL Actual' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "fin", Item = "vw_fact_gl_summary"]}[Data],
				    Kept = Table.SelectColumns(View, {"period_date_key", "posting_date", "account_key", "cost_center_key", "entity_key", "is_reversal", "amount_usd", "amount_usd_budget_rate"}),
				    InWindow = Table.SelectRows(Kept, each [posting_date] >= Date.From(RangeStart) and [posting_date] < Date.From(RangeEnd))
				in
				    InWindow

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: month
		incrementalPeriods: 3
		sourceExpression =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "fin", Item = "vw_fact_gl_summary"]}[Data],
				    Kept = Table.SelectColumns(View, {"period_date_key", "posting_date", "account_key", "cost_center_key", "entity_key", "is_reversal", "amount_usd", "amount_usd_budget_rate"}),
				    InWindow = Table.SelectRows(Kept, each [posting_date] >= Date.From(RangeStart) and [posting_date] < Date.From(RangeEnd))
				in
				    InWindow
