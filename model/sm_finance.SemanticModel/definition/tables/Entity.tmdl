	partition Entity = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "fin", Item = "vw_dim_entity"]}[Data],
				    Kept = Table.SelectColumns(View, {"entity_key", "entity_code", "entity_name", "country", "local_currency"})
				in
