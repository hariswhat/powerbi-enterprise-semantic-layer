	column 'Entity Key'
		dataType: int64
		isHidden
		lineageTag: 2405b81a-cba1-571c-a603-8a63a1c1b5de
		summarizeBy: none
		sourceColumn: entity_key

	column 'Entity Code'
		dataType: string
		lineageTag: eb6fe13e-c10f-54d5-b316-9d5943cb13d9
		summarizeBy: none
		sourceColumn: entity_code

	column Entity
		dataType: string
		lineageTag: 1e3fd290-acac-53d9-b8d0-4d23cc2966ca
